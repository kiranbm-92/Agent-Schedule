function handleLeadsImport(event) {  const file = event.target.files[0];  if (!file) return;
  const parseTextCSV = (text) => {    const lines = text.split(/\r?\n/).filter(line => line.trim().length > 0);    return lines.map(line => {      let cells = [], inQuotes = false, current = '';      for (let i = 0; i < line.length; i++) {        let char = line[i];        if (char === '"' || char === "'") { inQuotes = !inQuotes; }        else if (char === ',' && !inQuotes) { cells.push(current.trim()); current = ''; }        else { current += char; }      }      cells.push(current.trim());      return cells;    });  };
  const reader = new FileReader();  reader.onload = function(e) {    try {      let rows = [];      if (typeof XLSX !== 'undefined') {        const data = new Uint8Array(e.target.result);        const workbook = XLSX.read(data, { type: 'array' });        const firstSheetName = workbook.SheetNames[0];        rows = XLSX.utils.sheet_to_json(workbook.Sheets[firstSheetName], { header: 1 });      } else {        const text = new TextDecoder().decode(e.target.result);        rows = parseTextCSV(text);      }      processImportedLeads(rows, file.name);    } catch(err) {      const textReader = new FileReader();      textReader.onload = function(evt) {        const rows = parseTextCSV(evt.target.result);        processImportedLeads(rows, file.name);      };      textReader.readAsText(file);    }  };  reader.readAsArrayBuffer(file);}
function processImportedLeads(rows, fileName) {  if (!rows || rows.length < 2) return alert("File contains no lead rows.");  let header = rows[0].map(c => String(c || '').trim().toLowerCase().replace(/_/g, ' '));
  let idxName = -1, idxPhone = -1, idxQueue = -1, idxOwner = -1, idxStatus = -1;
  for (let j = 0; j < header.length; j++) {    let h = header[j];    if (h.includes("name") || h.includes("customer")) idxName = j;    else if (h.includes("phone") || h.includes("mobile") || h.includes("contact")) idxPhone = j;    else if (h.includes("queue") || h.includes("campaign")) idxQueue = j;    else if (h.includes("assignee") || h.includes("owner") || h.includes("caller") || h.includes("agent")) idxOwner = j;    else if (h.includes("status")) idxStatus = j;  }
  if (idxName === -1) idxName = 0;  if (idxPhone === -1) idxPhone = 1;  if (idxQueue === -1) idxQueue = 2;  if (idxOwner === -1) idxOwner = 3;
  let count = 0;  for (let i = 1; i < rows.length; i++) {    let cols = rows[i];    if (!cols || cols.length === 0) continue;    let name = String(cols[idxName] || '').trim();    let phone = String(cols[idxPhone] || '').trim();    let queue = idxQueue >= 0 ? String(cols[idxQueue] || '').trim() : "Calling Sales";    let owner = idxOwner >= 0 ? String(cols[idxOwner] || '').trim() : "agent001";    let status = idxStatus >= 0 ? String(cols[idxStatus] || '').trim() : "Pending";
    if (name) {      callingLeads.push({        id: "lead_" + Date.now() + "_" + Math.floor(Math.random()*1000),        customerName: name,        phone: phone,        queue: queue || "Calling Sales",        owner: owner || "agent001",        status: status || "Pending"      });      count++;    }  }
  saveAll();  renderLeads();  alert(`Successfully imported ${count} calling leads from ${fileName}!`);}

function syncLiveAuxTopPill(liveStatus) {  if (!currentUser || !liveStatus) return;  const userKey = currentUser.username.toLowerCase();  const myStatus = liveStatus[userKey];  if (myStatus && myStatus.auxKey) {    const auxChangedRemotely = (currentActiveAux !== myStatus.auxKey);    currentActiveAux = myStatus.auxKey;    if (myStatus.startTime) auxStartTime = myStatus.startTime;    if (auxChangedRemotely && typeof resetInactivityTimer === 'function') { resetInactivityTimer(); }    const a = auxByKey(currentActiveAux);    const pillDot = document.getElementById("pillDot");    const pillText = document.getElementById("pillText");    if (pillDot) pillDot.style.background = a?.color || "#ef4444";    if (pillText) pillText.textContent = a?.label || "Unavailable";  }}
function changeActiveAux(key, preservedStartTime){   const now = Date.now();   if(currentUser && currentActiveAux && !preservedStartTime){      const elapsed = (now - auxStartTime) / 1000;      logAuxSession(currentUser.username.toLowerCase(), today(), currentActiveAux, auxStartTime, now, elapsed);   }   currentActiveAux = key;   auxStartTime = preservedStartTime || now;   if(typeof resetInactivityTimer === 'function'){ resetInactivityTimer(); }   if(currentUser){      safeStorage.setItem("wfm_user_aux_state_" + currentUser.username.toLowerCase(), JSON.stringify({ auxKey: key, startTime: auxStartTime }));      let liveStatus = JSON.parse(safeStorage.getItem("wfm_live_agent_status") || "{}");        let userKey = currentUser.username.toLowerCase();
    liveStatus[userKey] = {          auxKey: key,          startTime: auxStartTime,          userRole: currentUser.role,          username: currentUser.username,          email: currentUser.email,          name: currentUser.name       };      safeStorage.setItem("wfm_live_agent_status", JSON.stringify(liveStatus));   }   const a = auxByKey(key);   document.getElementById("pillDot").style.background = a?.color || "#ef4444";   document.getElementById("pillText").textContent = a?.label || "Unavailable";   updateLiveTimer();   renderAgentHistory();   if(currentUser && isManagerOrAdmin()){ renderDashboard(); renderAttendance(); }  saveAll();}
function logAuxSession(userId, date, auxKey, start, end, durationSec){   syncStorageData();   const key=date+"_"+userId.toLowerCase();   if(!auxLogs[key]) auxLogs[key]=[];   auxLogs[key].push({ auxKey, startTime: new Date(start).toLocaleTimeString("en-IN", {hour12:false}), endTime: new Date(end).toLocaleTimeString("en-IN", {hour12:false}), durationSec: Math.round(durationSec) });   saveAll();}
function startClock(){   function tick(){      const d=new Date();      const dateStr = d.toLocaleDateString("en-IN", {day:"2-digit", month:"short", year:"numeric"});      const timeStr = d.toLocaleTimeString("en-IN", {hour12:false, hour:"2-digit", minute:"2-digit", second:"2-digit"});        const headerDateEl = document.getElementById("liveHeaderDate");      const liveClockEl = document.getElementById("liveClock");      if(headerDateEl) headerDateEl.textContent = dateStr;      if(liveClockEl) liveClockEl.textContent = timeStr;        updateLiveTimer();   }   tick();   if(timerInterval)clearInterval(timerInterval);   timerInterval=setInterval(tick,1000);}
function updateLiveTimer(){   const elapsedSeconds=Math.floor((Date.now()-auxStartTime)/1000);   const formattedTime=fmt(elapsedSeconds);   document.getElementById("pillTimer").textContent=formattedTime;   if(currentUser){      document.getElementById("currentAux").textContent=auxByKey(currentActiveAux)?.label||"-";      document.getElementById("currentTimer").textContent=formattedTime;      const histDate = document.getElementById("historyDate") ? document.getElementById("historyDate").value : today();      if(histDate === today()){ renderAgentHistory(); }      if(isManagerOrAdmin()){         renderDashboard();         const attSection = document.getElementById("attendanceSection");         if(attSection && !attSection.classList.contains("hidden")){ renderAttendance(); }         const manageMenu = document.getElementById("manageAgentsMenu");         if(manageMenu && !manageMenu.classList.contains("hidden")){            const activeEl = document.activeElement;            const menuHasFocus = activeEl && manageMenu.contains(activeEl);            if(!menuHasFocus){ renderManageAgentsList(); }         }      }   }}
function resetHistoryToToday(){ document.getElementById("historyDate").value=today(); renderAgentHistory();}
function dayKey(date,userId){ return date+"_"+String(userId).toLowerCase();}
function getAgentIdentifiers(agent) {   const ids = new Set();   if(!agent) return ids;
  if(agent.id) ids.add(String(agent.id).toLowerCase());   if(agent.username) ids.add(agent.username.trim().toLowerCase());   if(agent.email) ids.add(agent.email.trim().toLowerCase());
  return ids;}
/* UNIFIED CANONICAL ACCOUNT KEY LOOKUP ENGINE */function getAgentBlocks(agentId, date){   syncStorageData();   const agent = users.find(u => u.id === agentId || u.username === agentId || u.email === agentId) || currentUser;   const targetKey = agent ? agent.username.toLowerCase() : String(agentId).toLowerCase();
  let combinedBlocks = continuousSchedules[dayKey(date, targetKey)] || [];     if(!combinedBlocks || combinedBlocks.length === 0){    const ids = getAgentIdentifiers(agent || {id: agentId});    for(let idVal of ids) {      const altBlocks = continuousSchedules[dayKey(date, idVal)];      if(altBlocks && altBlocks.length > 0) {        combinedBlocks = altBlocks;        break;      }    }  }
  return [...(combinedBlocks || [])].sort((a,b) => a.startMin - b.startMin);}
function get15mGridSchedule(agentId, date){   syncStorageData();   const agent = users.find(u => u.id === agentId || u.username === agentId || u.email === agentId) || currentUser;   const targetKey = agent ? agent.username.toLowerCase() : String(agentId).toLowerCase();
  let grid = grid15mSchedules[dayKey(date, targetKey)];  if(!grid){    const ids = getAgentIdentifiers(agent || {id: agentId});    for(let idVal of ids) {      if(grid15mSchedules[dayKey(date, idVal)] && grid15mSchedules[dayKey(date, idVal)].some(x => x !== "")){        grid = grid15mSchedules[dayKey(date, idVal)];        break;      }    }  }
  if(!grid) grid = Array(96).fill("");   return grid;}
function timeLabel15m(i){ const h=Math.floor(i/4), m=(i%4)*15; return String(h).padStart(2,"0")+":"+String(m).padStart(2,"0");}
function getAgentScheduleDates(agentId){   syncStorageData();   const agent = users.find(u => u.id === agentId || u.username === agentId || u.email === agentId) || currentUser;   const ids = getAgentIdentifiers(agent || {id: agentId}); 
  const datesSet = new Set();   const allKeys = Object.keys(continuousSchedules).concat(Object.keys(grid15mSchedules));
  allKeys.forEach(key => {      const parts = key.split("_");      if(parts.length < 2) return;      const datePart = parts[0];      const keyUserId = parts.slice(1).join("_").toLowerCase();
    for(let idVal of ids) {         if(!idVal) continue;         if(keyUserId === idVal) {            datesSet.add(datePart);            break;         }      }   });
  const arr = Array.from(datesSet).sort();   return arr.length > 0 ? arr : [today()];}
/* RENDER CALLING LEADS MATRIX (ADMIN / TL GET ALL LEADS; AGENT SEES ONLY OWN ASSIGNED LEADS) */function renderLeads() {  if (!currentUser) return;  syncStorageData();
  const search = (document.getElementById("searchLeadInput")?.value || "").toLowerCase();  const statusFilter = document.getElementById("leadStatusFilter")?.value || "";
  const noticeElem = document.getElementById("leadsSubNotice");  if (noticeElem) {    if (isManagerOrAdmin()) {      noticeElem.textContent = "Admin / Team Leader View: Managing all uploaded customer calling leads across agents.";    } else {      noticeElem.textContent = `Agent View (${currentUser.name}): Displaying customer calling leads explicitly assigned to you.`;    }  }
  let list = callingLeads || [];
  // 1. Agent Lead Isolation: Agents see only leads assigned to their name or username

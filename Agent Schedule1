  // Real-time Cloud Data Listener (Broadcasts edits, live AUX, inactivity, calling leads & IP logs)
  onSnapshot(globalDocRef, (docSnap) => {    if (docSnap.exists()) {      const data = docSnap.data();      if (data.users) { users = data.users; safeStorage.setItem("wfm_users", JSON.stringify(users)); }      if (data.continuousSchedules) { continuousSchedules = data.continuousSchedules; safeStorage.setItem("wfm_continuous_schedules", JSON.stringify(continuousSchedules)); }      if (data.grid15mSchedules) { grid15mSchedules = data.grid15mSchedules; safeStorage.setItem("wfm_grid15m_schedules", JSON.stringify(grid15mSchedules)); }      if (data.auxLogs) { auxLogs = data.auxLogs; safeStorage.setItem("wfm_aux_logs", JSON.stringify(auxLogs)); }      if (data.inactivityLogs) { inactivityLogs = data.inactivityLogs; safeStorage.setItem("wfm_inactivity_logs", JSON.stringify(inactivityLogs)); }      if (data.locationLogs) { locationLogs = data.locationLogs; safeStorage.setItem("wfm_location_logs", JSON.stringify(locationLogs)); }      if (data.callingLeads) { callingLeads = data.callingLeads; safeStorage.setItem("wfm_calling_leads", JSON.stringify(callingLeads)); }      if (data.systemRoles) { systemRoles = data.systemRoles; safeStorage.setItem("wfm_system_roles", JSON.stringify(systemRoles)); }      if (data.liveStatus) {         safeStorage.setItem("wfm_live_agent_status", JSON.stringify(data.liveStatus));        syncLiveAuxTopPill(data.liveStatus);

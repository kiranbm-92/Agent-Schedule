
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>CoinDCX | WFM Schedule Plotter</title><style>:root{ --bg:#f5f7fb; --card:#fff; --text:#172033; --muted:#667085; --border:#dfe4ec; --primary:#0052ff; --primary-hover:#0038b8; --danger:#dc2626; --rowH:52px; --cellW:56px;}*{box-sizing:border-box}body{margin:0;font-family:Inter,Arial,sans-serif;background:var(--bg);color:var(--text);user-select:none}button,input,select{font:inherit}button{cursor:pointer;border:0}.hidden{display:none!important}/* ENTERPRISE COINDCX CRM LOGIN SCREEN -- split-panel design, classes prefixed ls- so they never affect the rest of the app's shared .field/.primary/.secondary styles */

  const lastOfflineSessions = sessions.filter(s => s.auxKey === "offline");
  const lastOfflineSession = lastOfflineSessions.length > 0 ? lastOfflineSessions[lastOfflineSessions.length - 1] : null;

  const firstAvailable = firstAvailSession ? firstAvailSession.startTime : (isToday ? "Pending" : "NA");
  const lastOffline = lastOfflineSession ? lastOfflineSession.startTime : (isToday ? "Active" : "NA");

  return { firstAvailable, lastOffline };
}

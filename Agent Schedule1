function closeResetModal(){ document.getElementById("resetModal").classList.add("hidden"); stopOtpCountdown();}
let currentCaptchaText = "", otpCountdownInterval = null, otpExpiryTime = null;
function generateCaptchaText(){   const upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";   const lower = "abcdefghijkmnpqrstuvwxyz";   const digits = "23456789";   const all = upper + lower + digits;   const length = 6;   let chars = [      upper[Math.floor(Math.random()*upper.length)],      lower[Math.floor(Math.random()*lower.length)],      digits[Math.floor(Math.random()*digits.length)]   ];   while(chars.length < length){ chars.push(all[Math.floor(Math.random()*all.length)]); }   for(let i=chars.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); const tmp=chars[i]; chars[i]=chars[j]; chars[j]=tmp; }   return chars.join("");}
function regenerateCaptcha(){   currentCaptchaText = generateCaptchaText();   const el = document.getElementById("captchaDisplay");   if(el){ el.textContent = currentCaptchaText; }   const inp = document.getElementById("captchaInput");   if(inp) inp.value = "";}
function isValidEmailFormat(email){   return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);}
function friendlyCloudFnError(err, notConfiguredMsg){   const code = String(err?.code || "");   if(code.includes("not-found") || code.includes("unavailable") || code.includes("internal") && !err?.message){      return notConfiguredMsg;   }   return err?.message || "Something went wrong. Please try again.";}
// STEP 1: request an OTP. The code itself is generated, hashed and stored SERVER-SIDE only (see
// functions/index.js, requestPasswordResetOtp) and emailed to the real inbox -- this browser session
// never learns the correct code at any point. There is deliberately no client-side fallback that shows
// the code on screen: if the Cloud Function isn't deployed yet, the person is told to contact their Admin.
async function sendOTP(isResend){   const email=document.getElementById("resetEmail").value.trim();   const captchaVal=document.getElementById("captchaInput").value.trim();   document.getElementById("resetError").textContent="";
  if(!email || !isValidEmailFormat(email)){      document.getElementById("resetError").textContent="Please enter a valid email address (e.g. name@gmail.com, name@outlook.com, or your company domain).";      return;   }
  if(!isResend){      if(!captchaVal || captchaVal !== currentCaptchaText){         document.getElementById("resetError").textContent="Verification code does not match. Please try again.";         regenerateCaptcha();         return;      }   }
  const triggerBtn = isResend ? document.getElementById("resendOtpBtn") : document.getElementById("sendOtpBtn");   const originalBtnText = triggerBtn ? triggerBtn.textContent : "";   if(triggerBtn){ triggerBtn.disabled = true; triggerBtn.textContent = "Sending..."; }
  try {      if (!window.requestPasswordResetOtpCloudFn) { throw new Error("Cloud Functions not initialized"); }      await window.requestPasswordResetOtpCloudFn({ email });   } catch (err) {      if(triggerBtn){ triggerBtn.disabled = false; triggerBtn.textContent = originalBtnText; }      document.getElementById("resetError").textContent = friendlyCloudFnError(err, "Password reset by email isn't set up on this system yet. Please contact your WFM Admin to reset your password.");      return;   }
  const noticeEl = document.getElementById("otpDeliveryNotice");   if (noticeEl) {      noticeEl.classList.remove("hidden");      noticeEl.innerHTML = `A verification code has been sent to <b>${esc(email)}</b>. Check the inbox (and spam folder) -- it expires in 60 seconds.`;   }
  if(triggerBtn){ triggerBtn.disabled = false; triggerBtn.textContent = originalBtnText; }   document.getElementById("otpStep1").classList.add("hidden");   document.getElementById("otpStep2").classList.remove("hidden");   document.getElementById("otpInput").value="";   document.getElementById("resetError").textContent="";   startOtpCountdown();}
function startOtpCountdown(){   stopOtpCountdown();   const totalSecs = 60;   otpExpiryTime = Date.now() + totalSecs*1000;   document.getElementById("otpCountdown").textContent = totalSecs;   document.getElementById("otpExpiredNote").classList.add("hidden");   document.getElementById("verifyOtpBtn").disabled = false;   document.getElementById("resendOtpBtn").disabled = true;   document.getElementById("otpInput").disabled = false;
  otpCountdownInterval = setInterval(()=>{      const secsLeft = Math.max(0, Math.ceil((otpExpiryTime - Date.now())/1000));      const cdEl = document.getElementById("otpCountdown");      if(cdEl) cdEl.textContent = secsLeft;      if(secsLeft <= 0){         stopOtpCountdown();         document.getElementById("otpExpiredNote").classList.remove("hidden");         document.getElementById("verifyOtpBtn").disabled = true;         document.getElementById("resendOtpBtn").disabled = false;         document.getElementById("otpInput").disabled = true;      }   }, 250);}
function stopOtpCountdown(){   if(otpCountdownInterval){ clearInterval(otpCountdownInterval); otpCountdownInterval=null; }}
// STEP 2: verify the OTP server-side (functions/index.js, verifyPasswordResetOtp). Only advances the
// UI to the new-password step on a genuine server-confirmed match; the code is re-checked again at
// the final submit step too, so this step alone is never sufficient to change the password.
async function verifyOTP(){   const enteredOTP=document.getElementById("otpInput").value.trim();   const email=document.getElementById("resetEmail").value.trim();   document.getElementById("resetError").textContent="";
  if(!enteredOTP || enteredOTP.length!==6){ document.getElementById("resetError").textContent="Enter the 6-digit code sent to your email."; return; }
  const verifyBtn = document.getElementById("verifyOtpBtn");   const originalText = verifyBtn ? verifyBtn.textContent : "";   if(verifyBtn){ verifyBtn.disabled=true; verifyBtn.textContent="Verifying..."; }
  try {      if (!window.verifyPasswordResetOtpCloudFn) { throw new Error("Cloud Functions not initialized"); }      await window.verifyPasswordResetOtpCloudFn({ email, code: enteredOTP });   } catch (err) {      if(verifyBtn){ verifyBtn.disabled=false; verifyBtn.textContent=originalText; }      document.getElementById("resetError").textContent = friendlyCloudFnError(err, "Password reset by email isn't set up on this system yet. Please contact your WFM Admin.");      return;   }
  if(verifyBtn){ verifyBtn.disabled=false; verifyBtn.textContent=originalText; }   stopOtpCountdown();   document.getElementById("otpStep2").classList.add("hidden");   document.getElementById("otpStep3").classList.remove("hidden");   document.getElementById("newPassInput").value="";   document.getElementById("confirmPassInput").value="";}
function isStrongPassword(pw){   return /^(?=.*[A-Za-z])(?=.*\d)(?=.*[^A-Za-z0-9\s]).{8,}$/.test(pw);}
// STEP 3: re-verify the code AND write the new password, both server-side and atomically (functions/index.js,
// resetPasswordWithOtp) -- the browser never writes the password field itself for a reset.
async function submitNewPassword(){   const p1=document.getElementById("newPassInput").value;   const p2=document.getElementById("confirmPassInput").value;   const email=document.getElementById("resetEmail").value.trim();   const otpVal=document.getElementById("otpInput").value.trim();   document.getElementById("resetError").textContent="";
  if(!isStrongPassword(p1)){ document.getElementById("resetError").textContent="Password must be at least 8 characters and include a letter, a number, and a special character."; return; }   if(p1!==p2){ document.getElementById("resetError").textContent="Passwords do not match."; return; }
  const saveBtn = document.getElementById("saveNewPasswordBtn");   const originalText = saveBtn ? saveBtn.textContent : "";   if(saveBtn){ saveBtn.disabled=true; saveBtn.textContent="Saving..."; }
  try {      if (!window.resetPasswordWithOtpCloudFn) { throw new Error("Cloud Functions not initialized"); }      await window.resetPasswordWithOtpCloudFn({ email, code: otpVal, newPassword: p1 });   } catch (err) {      if(saveBtn){ saveBtn.disabled=false; saveBtn.textContent=originalText; }      document.getElementById("resetError").textContent = friendlyCloudFnError(err, "Password reset by email isn't set up on this system yet. Please contact your WFM Admin.");      return;   }
  if(saveBtn){ saveBtn.disabled=false; saveBtn.textContent=originalText; }   alert("Password reset successful! You can now log in with your new password.");   closeResetModal();}

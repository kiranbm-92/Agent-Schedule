function renderManageAgentsList(){   if(!currentUser || !isManagerOrAdmin()) return;   syncStorageData();   const search=(document.getElementById("manageAgentSearch")?.value||"").toLowerCase();   const liveStatus=JSON.parse(safeStorage.getItem("wfm_live_agent_status")||"{}");   let agents=users.filter(u=>u.role==="agent"||u.role==="team_leader");   agents=agents.filter(u=>u.username.toLowerCase()!==currentUser.username.toLowerCase());   if(search){ agents=agents.filter(a=>a.name.toLowerCase().includes(search)||a.username.toLowerCase().includes(search)); }   const list=document.getElementById("manageAgentsList");   if(!list) return;   if(agents.length===0){ list.innerHTML=`<div style="padding:10px;font-size:12px;color:#667085;text-align:center">No agents found.</div>`; return; }   list.innerHTML=agents.map(a=>{      const liveObj=matchLiveStatusObj(liveStatus,a);      const auxKey=liveObj?.auxKey||"offline";      const auxObj=auxByKey(auxKey);      const auxOptionsHtml=LIVE_DROPDOWN_AUX.map(x=>`<option value="${x.key}" ${x.key===auxKey?'selected':''}>${x.label}</option>`).join("");      return `<div style="padding:8px 10px;border-radius:8px;background:#f8fafc;margin-bottom:6px">        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">          <div style="min-width:0">            <div style="font-weight:800;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(a.name)}</div>            <div style="font-size:10px;color:#667085">${esc(a.username)} • ${esc(a.queue||"")}</div>          </div>          <span class="status-dot" style="background:${auxObj?.color||'#64748b'};flex-shrink:0"></span>        </div>        <div style="display:flex;gap:6px;margin-top:6px">          <select style="flex:1;padding:5px 6px;border-radius:6px;border:1px solid #cbd5e1;font-size:11px;font-weight:700" onchange="managerChangeAgentAux('${a.username}', this.value)">${auxOptionsHtml}</select>          <button class="danger" style="padding:5px 8px;font-size:10px;font-weight:800" onclick="managerForceLogout('${a.username}')">Force Logout</button>        </div>      </div>`;   }).join("");}
function managerChangeAgentAux(username, auxKey){   if(!currentUser || !isManagerOrAdmin()) return;   syncStorageData();   const agent=users.find(u=>u.username.toLowerCase()===username.toLowerCase());   if(!agent) return;   let liveStatus=JSON.parse(safeStorage.getItem("wfm_live_agent_status")||"{}");   const userKey=agent.username.toLowerCase();   const now=Date.now();   const prevObj=liveStatus[userKey];   if(prevObj && prevObj.auxKey && prevObj.startTime){      const elapsed=(now-prevObj.startTime)/1000;      if(elapsed>0){ logAuxSession(userKey, today(), prevObj.auxKey, prevObj.startTime, now, elapsed); }   }   liveStatus[userKey]={ auxKey:auxKey, startTime:now, userRole:agent.role, username:agent.username, email:agent.email, name:agent.name, managerOverride:true, overrideBy:currentUser.username };   safeStorage.setItem("wfm_live_agent_status", JSON.stringify(liveStatus));   saveAll();   renderManageAgentsList();   renderDashboard();   renderAttendance();}
function managerForceLogout(username){   if(!currentUser || !isManagerOrAdmin()) return;   if(!confirm(`Force logout agent '${username}' now? This ends their active session immediately.`)) return;   syncStorageData();   const agent=users.find(u=>u.username.toLowerCase()===username.toLowerCase());   if(!agent) return;   let liveStatus=JSON.parse(safeStorage.getItem("wfm_live_agent_status")||"{}");   const userKey=agent.username.toLowerCase();   const now=Date.now();   const prevObj=liveStatus[userKey];   if(prevObj && prevObj.auxKey && prevObj.startTime){      const elapsed=(now-prevObj.startTime)/1000;      if(elapsed>0){ logAuxSession(userKey, today(), prevObj.auxKey, prevObj.startTime, now, elapsed); }   }   liveStatus[userKey]={ auxKey:"offline", startTime:now, userRole:agent.role, username:agent.username, email:agent.email, name:agent.name, forceLogout:true, forceLogoutAt:now, forceLogoutBy:currentUser.username };   safeStorage.setItem("wfm_live_agent_status", JSON.stringify(liveStatus));   safeStorage.removeItem("wfm_user_aux_state_"+userKey);   saveAll();   renderManageAgentsList();   renderDashboard();   renderAttendance();}

      safeStorage.setItem("wfm_grid15m_schedules", JSON.stringify(appState.grid15mSchedules));
      safeStorage.setItem("wfm_aux_logs", JSON.stringify(appState.auxLogs));
      safeStorage.setItem("wfm_inactivity_logs", JSON.stringify(appState.inactivityLogs));
      safeStorage.setItem("wfm_location_logs", JSON.stringify(appState.locationLogs));
      safeStorage.setItem("wfm_calling_leads", JSON.stringify(appState.callingLeads));
      safeStorage.setItem("wfm_system_roles", JSON.stringify(appState.systemRoles));
    } catch (e) { console.error("Local persist error:", e); }

    try {      await setDoc(globalDocRef, appState, { merge: true });      if (typeof showSyncBanner === 'function') showSyncBanner(false);    } catch (e) {      console.error("Firestore Sync Error: ", e);      if (typeof showSyncBanner === 'function') showSyncBanner(true, e.message);    }  };</script></head><body><!-- LOGIN SCREEN: SPLIT-PANEL DESIGN (brand statement left, sign-in card right) --><section id="loginScreen" class="ls-screen"> <div class="ls-panel">  <svg class="ls-panel-lines" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">   <polyline points="0,420 60,400 120,430 180,360 240,380 300,300 360,330 420,240 480,270" fill="none" stroke="#3b6bff" stroke-width="3"/>   <polyline points="0,470 60,450 120,460 180,410 240,420 300,370 360,390 420,320 480,340" fill="none" stroke="#ff5b2e" stroke-width="3" opacity="0.6"/>  </svg>  <div class="ls-brand">Coin<span>DCX</span> <span class="ls-brand-sub">| WFM</span></div>  <div class="ls-statement">   <h1>Workforce, in sync.</h1>   <p>Real-time AUX tracking, scheduling and reporting for every agent, team lead and admin — one place, always current.</p>  </div>  <div class="ls-panel-spacer"></div> </div> <div class="ls-form-side">  <div class="ls-orb-blue"></div>  <div class="ls-orb-orange"></div>  <svg class="ls-arc-art" viewBox="0 0 900 900" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">   <circle cx="750" cy="120" r="180" fill="none" stroke="#3b6bff" stroke-width="1" opacity="0.15"/>   <circle cx="750" cy="120" r="240" fill="none" stroke="#3b6bff" stroke-width="1" opacity="0.1"/>   <circle cx="120" cy="820" r="150" fill="none" stroke="#ff5b2e" stroke-width="1" opacity="0.14"/>   <circle cx="120" cy="820" r="210" fill="none" stroke="#ff5b2e" stroke-width="1" opacity="0.09"/>  </svg>  <div class="ls-card">   <div class="ls-mark"></div>   <h2>Sign in</h2>   <p class="ls-sub">Enter your assigned account credentials to continue.</p>   <div class="ls-field">    <label>Email or username</label>    <div class="ls-input-wrap">     <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>     <input id="loginUser" type="text" placeholder="Enter your email or username">    </div>   </div>   <div class="ls-field">    <label>Password</label>    <div class="ls-input-wrap">     <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>     <input id="loginPass" type="password" placeholder="Enter password" onkeypress="if(event.key==='Enter'){ login(); }">    </div>   </div>   <div class="ls-reset-row"><span class="ls-reset-link" onclick="openResetModal()">Reset password?</span></div>   <button class="ls-submit" onclick="login()">Sign in</button>   <div id="loginError" class="login-error"></div>   <p class="ls-foot-note">Having trouble signing in? Contact your WFM Admin.</p>  </div> </div></section><!-- DOUBLE-CLICK EXACT TIME PLOT MODAL --><div id="timePlotModal" class="modal-overlay hidden"> <div class="modal-card">  <h2 style="margin-top:0;margin-bottom:8px">Plot AUX Schedule Block</h2>  <p style="color:var(--muted);font-size:13px;margin-top:0;margin-bottom:18px">Select exact Start Time, End Time, and AUX Code for <b id="modalAgentName"></b>.</p>  <div class="field">   <label>AUX Code</label>   <select id="modalAuxSelect"></select>  </div>  <div class="field" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">   <div>    <label>Start Time (HH:MM)</label>    <input id="modalStartTime" type="time" value="09:00">   </div>   <div>    <label>End Time (HH:MM)</label>    <input id="modalEndTime" type="time" value="10:00">   </div>  </div>  <div id="plotError" class="login-error"></div>  <div style="display:flex;gap:10px;margin-top:16px">   <button class="primary" style="flex:1" onclick="confirmTimePlot()">Save Block</button>   <button class="secondary" style="flex:1" onclick="closeTimePlotModal()">Cancel</button>  </div> </div></div><!-- RESET PASSWORD MODAL --><div id="resetModal" class="modal-overlay hidden"> <div class="modal-card">  <h2 style="margin-top:0;margin-bottom:8px">Reset Password</h2>  <p style="color:var(--muted);font-size:13px;margin-top:0;margin-bottom:18px" id="resetStepDesc">Enter your active email address and the verification code shown below.</p>  <div id="otpStep1">   <div class="field">    <label>Active Email Address</label>    <input id="resetEmail" type="email" placeholder="e.g. yourname@gmail.com or yourname@outlook.com">   </div>   <div class="field">    <label>Verification Code</label>    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">     <div id="captchaDisplay" style="flex:1;background:#0f172a;color:#fff;border-radius:8px;padding:10px;text-align:center;font-weight:900;font-size:20px;letter-spacing:6px;user-select:none;font-family:monospace"></div>     <button type="button" class="secondary" onclick="regenerateCaptcha()" title="Refresh code" style="padding:10px 14px">↻</button>    </div>    <input id="captchaInput" type="text" placeholder="Case-sensitive — enter exactly as shown">   </div>   <button class="primary" style="width:100%" id="sendOtpBtn" onclick="sendOTP()">Send 6-Digit OTP</button>  </div>  <div id="otpStep2" class="hidden">   <div id="otpDeliveryNotice" class="hidden" style="background:#eef4ff;border:1px solid #bfdbfe;border-radius:10px;padding:12px 14px;margin-bottom:16px;font-size:12.5px;color:#1e3a8a;line-height:1.5"></div>   <div class="field">    <label>Enter 6-Digit OTP</label>    <input id="otpInput" type="text" maxlength="6" placeholder="123456">   </div>   <p style="font-size:12px;color:var(--muted);margin-top:-8px;margin-bottom:16px">Code expires in <b id="otpCountdown">60</b>s. <span id="otpExpiredNote" class="hidden" style="color:var(--danger);font-weight:700">Code expired — please resend.</span></p>   <button class="primary" style="width:100%" id="verifyOtpBtn" onclick="verifyOTP()">Verify OTP</button>   <button class="secondary" style="width:100%;margin-top:8px" id="resendOtpBtn" onclick="sendOTP(true)" disabled>Resend OTP</button>  </div>  <div id="otpStep3" class="hidden">   <div class="field">    <label>New Password</label>    <input id="newPassInput" type="password" placeholder="Minimum 8 characters">   </div>   <div class="field">    <label>Confirm New Password</label>    <input id="confirmPassInput" type="password" placeholder="Re-enter new password">   </div>   <p style="font-size:11px;color:var(--muted);margin-top:-8px;margin-bottom:16px">Must be at least 8 characters and include a letter, a number, and a special character.</p>   <button class="primary" style="width:100%" id="saveNewPasswordBtn" onclick="submitNewPassword()">Save New Password</button>  </div>  <div id="resetError" class="login-error"></div>  <button class="secondary" style="width:100%;margin-top:10px" onclick="closeResetModal()">Cancel</button> </div></div><!-- FIRST LOGIN MANDATORY PASSWORD CHANGE MODAL --><div id="forceChangeModal" class="modal-overlay hidden"> <div class="modal-card">  <h2 style="margin-top:0;margin-bottom:8px">First-Time Login Security</h2>  <p style="color:var(--muted);font-size:13px;margin-top:0;margin-bottom:18px">You must update your password after resetting it before continuing.</p>  <div class="field">   <label>New Password</label>   <input id="forceNewPass" type="password" placeholder="Enter new password">  </div>  <div class="field">   <label>Confirm Password</label>   <input id="forceConfirmPass" type="password" placeholder="Confirm new password">  </div>  <div id="forceError" class="login-error"></div>  <button class="primary" style="width:100%;margin-top:10px" onclick="submitFirstLoginChange()">Update Password & Access System</button> </div></div><!-- LOGOUT-WITHOUT-OFFLINE WARNING MODAL --><div id="logoutWarningModal" class="modal-overlay hidden"> <div class="modal-card">  <h2 style="margin-top:0;margin-bottom:8px">⚠️ Set AUX to Offline First</h2>  <p style="color:var(--muted);font-size:13px;margin-top:0;margin-bottom:18px">You're currently on <b id="logoutWarningAuxLabel">-</b>. Please switch your AUX status to <b>Offline</b> before logging out, so your session time is recorded correctly.</p>  <div style="display:flex;gap:10px;margin-top:16px">   <button class="primary" style="flex:1" onclick="setOfflineAndLogout()">Set to Offline & Logout</button>   <button class="secondary" style="flex:1" onclick="closeLogoutWarningModal()">Cancel</button>  </div> </div></div><!-- APP --><section id="app" class="hidden"><header class="topbar"> <div class="brand" style="display:flex;align-items:center;gap:12px">  <span style="font-weight:900;font-size:18px;letter-spacing:-0.5px">   <span style="color:#172554">Coin</span><span style="color:#ff3b00">DCX</span>    <span style="font-weight:500;font-size:14px;color:#64748b">| WFM Schedule Plotter</span>  </span> </div> <!-- CENTERED AGENT NAME, ROLE, SYSTEM DATE & TIME DISPLAY FOR ALL LOGINS --> <div class="header-center-clock">  <span style="color:#0052ff;font-weight:900">👤 <span id="centerUserNameRole"></span></span>  <span style="color:#cbd5e1">|</span>  <span>📅 <span id="liveHeaderDate"></span></span>  <span style="color:#cbd5e1">|</span>  <span>⏰ <span id="liveClock"></span></span> </div> <span id="roleBadge" class="badge"></span> <span id="topUser" class="badge"></span> <div class="aux-dropdown-container">  <div class="aux-status-pill" onclick="toggleAuxDropdown()">   <span id="pillDot" class="status-dot" style="background:#ef4444"></span>   <span id="pillText">Unavailable</span>   <span id="pillTimer" style="margin-left:4px">00:00:00</span>  </div>  <div id="auxDropdownMenu" class="aux-dropdown-menu hidden">   <input id="auxSearchInput" class="aux-search-input" placeholder="🔍 Search AUX status..." oninput="filterAuxDropdown()">   <div id="auxOptionList" class="aux-option-list"></div>  </div> </div> <div class="aux-dropdown-container managerOnly" id="manageAgentsContainer" style="margin-left:8px">  <div class="aux-status-pill" style="background:#eef2ff;border-color:#93c5fd" onclick="toggleManageAgentsDropdown()">   <span>🧑‍💼</span><span>Manage Agents</span>  </div>  <div id="manageAgentsMenu" class="aux-dropdown-menu hidden" style="width:340px">   <input id="manageAgentSearch" class="aux-search-input" placeholder="🔍 Search agent..." oninput="renderManageAgentsList()">   <div id="manageAgentsList" class="aux-option-list" style="max-height:320px"></div>  </div> </div> <button class="secondary" style="margin-left:8px" onclick="logout()">Logout</button></header><main class="container"> <div class="tabs">  <button id="plotTab" class="tab active" onclick="showTab('plot')">Schedule Plotter</button>  <button id="agentTab" class="tab" onclick="showTab('agent')">My Status & History</button>  <button id="leadsTab" class="tab" onclick="showTab('leads')">Calling Leads</button>  <button id="dashboardTab" class="tab managerOnly" onclick="showTab('dashboard')">Reporting Dashboard</button>  <button id="attendanceTab" class="tab managerOnly" onclick="showTab('attendance')">Agent Attendance Logs</button>  <button id="adminTab" class="tab adminOnly" onclick="showTab('admin')">Admin</button>  <button id="settingsTab" class="tab adminOnly" onclick="showTab('settings')">Settings</button> </div> <!-- PLOTTER --> <section id="plotSection">  <div class="toolbar">   <label class="managerOnly" style="font-size:13px;font-weight:700">From Date:</label>   <input id="scheduleFromDate" class="managerOnly" type="date" onchange="renderPlot()" oninput="renderPlot()">   <label class="managerOnly" style="font-size:13px;font-weight:700">To Date:</label>   <input id="scheduleToDate" class="managerOnly" type="date" onchange="renderPlot()" oninput="renderPlot()">      <input id="scheduleDate" class="hidden" type="date" onchange="renderPlot()">      <input id="searchAgent" class="managerOnly" placeholder="Search agent..." oninput="renderPlot()">   <select id="agencyFilter" class="managerOnly" onchange="renderPlot()"><option value="">All Agencies</option></select>   <select id="queueFilter" class="managerOnly" onchange="renderPlot()"><option value="">All Queues</option></select>   <select id="plotModeSelect" class="managerOnly" onchange="switchPlotMode()" style="font-weight:700;border:1px solid #2563eb;color:#2563eb">    <option value="timeline">24-Hour Continuous Timeline View</option>    <option value="grid15m">15-Minute Grid Interval Plotter View</option>   </select>   <input type="file" id="excelFileInput" accept=".xlsx, .xls, .csv" class="hidden" onchange="handleExcelImport(event)">   <button class="secondary managerOnly" onclick="downloadSampleTemplate()">📥 Download Sample Template (.csv)</button>   <button class="secondary adminOnly" onclick="document.getElementById('excelFileInput').click()">📤 Import Excel/CSV</button>   <button class="primary adminOnly" onclick="addAgent()">+ Add Agent</button>   <button class="danger adminOnly" onclick="clearWholeDaySchedule()" style="background:#dc2626">🗑️ Clear Active Date (All Agents)</button>   <button class="secondary adminOnly" onclick="clearSelectedAgent()">Clear Particular Agent Schedule</button>   <button class="danger adminOnly" onclick="clearEntireDatabaseSchedules()" style="background:#991b1b">⚠️ Clear ALL System Schedules (All Dates)</button>   <button class="secondary adminOnly" onclick="saveSchedules()">Save Schedule</button>   <button class="secondary managerOnly" onclick="exportCSV()">Export AUX CSV</button>  </div>  <div class="card managerOnly">   <b>Schedule Plotter Tools:</b>   <div id="modeInstructionText" style="font-size:12px;color:#667085;margin-top:4px">    • <b>Drag from Legend:</b> Drag any AUX code onto the 24-hour timeline to create a block.<br>    • <b>Drag Plotted Blocks:</b> Drag an existing block horizontally to reposition it. Movement snaps to 15 minutes.<br>    • <b>Double-click:</b> Choose exact AUX/start/end time.<br>    • <b>15-minute view:</b> Click/drag across cells to paint an AUX code; right-click to clear.<br>    • <b>Excel:</b> Upload multiple agents/dates/AUX rows. Intersecting block ranges are automatically trimmed and split so schedules never overlap visually!   </div>   <div style="font-size:12px;font-weight:700;margin-top:10px">Work & Leave AUX Codes (Drag or click to plot):</div>   <div class="legend" id="legend" style="margin-top:6px"></div>  </div>  <div id="timelinePlotWrap" class="plot-wrap">   <div class="plot-grid">    <div>     <div class="agent-head-cell">      <span id="agentHeadLabel">Agent Info / All Uploaded Schedule Dates</span>      <small id="copiedNotice" style="color:#2563eb;font-weight:bold"></small>     </div>     <div id="agentRowsContainer"></div>    </div>    <div>     <div class="timeline-header" id="timelineHeader"></div>     <div id="timelineTracksContainer"></div>    </div>   </div>  </div>  <div id="grid15mPlotWrap" class="plot-wrap hidden">   <div id="grid15mContainer" class="plot-grid-15m"></div>  </div> </section> <!-- MY STATUS & HISTORICAL CALENDAR --> <section id="agentSection" class="hidden">  <div class="toolbar">   <label style="font-size:13px;font-weight:700">Historical Date Filter:</label>   <input id="historyDate" type="date" onchange="renderAgentHistory()">   <button class="secondary" onclick="resetHistoryToToday()">Today</button>  </div>  <div class="agent-panel">   <div class="card">    <h2 style="margin-top:0">Live AUX Running Status</h2>    <div class="current-status">     <div><div style="color:#667085;font-size:12px">Current AUX</div><div id="currentAux" class="status-code">-</div></div>     <div style="text-align:right"><div style="color:#667085;font-size:12px">Running Duration</div><div id="currentTimer" class="status-timer">00:00:00</div></div>    </div>    <p style="font-size:12px;color:#667085">Changes made in the top-right status dropdown automatically calculate and record live session durations.</p>   </div>   <div class="card">    <h3 style="margin-top:0">Total Summary (<span id="historyDateLabel"></span>)</h3>    <div id="todaySummary"></div>   </div>  </div>  <div class="card">   <h3>Historical AUX Logs (<span id="historyLogLabel"></span>)</h3>   <div id="agentUsageTable"></div>  </div> </section>
 <!-- CALLING LEADS TAB FOR ADMINS, TLS & AGENTS --> <section id="leadsSection" class="hidden">  <div class="card">   <div class="toolbar" style="margin-bottom:14px; gap:12px;">    <input id="searchLeadInput" placeholder="🔍 Search customer name, phone, queue, assignee..." oninput="renderLeads()" style="width:280px">    <select id="leadStatusFilter" onchange="renderLeads()">     <option value="">All Statuses</option>     <option value="Pending">Pending</option>     <option value="In Progress">In Progress</option>     <option value="Completed">Completed</option>     <option value="Follow Up">Follow Up</option>    </select>    <input type="file" id="leadsFileInput" accept=".xlsx, .xls, .csv" class="hidden" onchange="handleLeadsImport(event)">    <button class="primary managerOnly" onclick="document.getElementById('leadsFileInput').click()">📤 Import Leads (.csv / .xlsx)</button>    <button class="secondary managerOnly" onclick="downloadSampleLeadsTemplate()">📥 Download Leads Template (.csv)</button>    <button class="danger adminOnly" onclick="clearAllCallingLeads()" style="background:#dc2626">🗑️ Clear All Leads</button>   </div>   <h3 style="margin-top:0">Assigned Calling Customer Leads Matrix</h3>   <p style="color:var(--muted);font-size:12px;margin-top:-6px;margin-bottom:14px" id="leadsSubNotice">    Agents will only see customer calling leads where their name/username is assigned as the owner/caller.   </p>   <div class="table-scroll">    <table class="data-table">     <thead>      <tr>       <th>Customer Name</th>       <th>Phone Number</th>       <th>Queue / Campaign</th>       <th>Assignee / Owner / Caller</th>       <th>Status</th>       <th>Action Contact</th>      </tr>     </thead>     <tbody id="leadsTableBody"></tbody>    </table>   </div>  </div> </section>
 <!-- DASHBOARD WITH INACTIVE SUMMARY TIME COLUMN & MULTI-SELECT DROPDOWNS --> <section id="dashboardSection" class="hidden">  <div class="toolbar">   <label style="font-size:12px;font-weight:700">From:</label>   <input id="reportFromDate" type="date" onchange="renderDashboard()" oninput="renderDashboard()" style="width:130px">   <label style="font-size:12px;font-weight:700">To:</label>   <input id="reportToDate" type="date" onchange="renderDashboard()" oninput="renderDashboard()" style="width:130px">   <label style="font-size:12px;font-weight:700;margin-left:6px">Agencies:</label>   <select id="dashAgencyFilter" class="multi-select" multiple onchange="renderDashboard()" title="Hold Ctrl/Cmd to select multiple agencies"></select>   <label style="font-size:12px;font-weight:700;margin-left:6px">Queues:</label>   <select id="dashQueueFilter" class="multi-select" multiple onchange="renderDashboard()" title="Hold Ctrl/Cmd to select multiple queues"></select>   <button class="secondary managerOnly" onclick="exportDashboardCSV()">Export Detailed AUX Report</button>  </div>  <div id="dashboardKpis" class="kpis"></div>  <div class="card">   <h3>Agent Status Summary</h3>   <div class="table-scroll"><table class="data-table"><thead><tr>    <th>Agent</th><th>Date</th><th>Agency</th><th>Queue</th><th>Shift</th><th>Assigned Shift Code</th><th>Current AUX</th>    <th>Available</th><th>Inactive Time</th><th>Break</th><th>Lunch</th><th>Bio Break</th><th>Team Meeting</th>    <th>TL Feedback</th><th>QA Feedback</th><th>NHT Training</th><th>PKT Training</th>    <th>Training</th><th>Coaching</th><th>Unavailable</th><th>Offline</th>   </tr></thead><tbody id="dashboardBody"></tbody></table></div>  </div> </section>
 <!-- AGENT ATTENDANCE SUB-DASHBOARD WITH SUB-TABS & MULTI-SELECT DROPDOWNS --> <section id="attendanceSection" class="hidden">  <div class="card">   <div class="toolbar" style="margin-bottom:10px; gap:8px;">    <label style="font-size:12px;font-weight:700">From:</label>    <input id="attendanceFromDate" type="date" onchange="renderAttendance()" oninput="renderAttendance()" style="width:130px">    <label style="font-size:12px;font-weight:700">To:</label>    <input id="attendanceToDate" type="date" onchange="renderAttendance()" oninput="renderAttendance()" style="width:130px">    <input id="searchAttendanceAgent" placeholder="Search agent name/username..." oninput="renderAttendance()" style="width:180px">    <label style="font-size:12px;font-weight:700">Agencies:</label>    <select id="attAgencyFilter" class="multi-select" multiple onchange="renderAttendance()" title="Hold Ctrl/Cmd to select multiple agencies"></select>    <label style="font-size:12px;font-weight:700">Queues:</label>    <select id="attQueueFilter" class="multi-select" multiple onchange="renderAttendance()" title="Hold Ctrl/Cmd to select multiple queues"></select>    <button class="secondary managerOnly" onclick="exportAttendanceCSV()">Export Attendance CSV</button>   </div>
   <!-- SUB-TAB TOGGLES FOR ATTENDANCE, INACTIVITY FREQUENCY & IP/LOCATION LOGS -->   <div class="sub-tabs">    <button id="subTabSummary" class="sub-tab active" onclick="switchAttendanceSubTab('summary')">Daily Summary Logs</button>    <button id="subTabInactivity" class="sub-tab" onclick="switchAttendanceSubTab('inactivity')">Agent Inactivity Frequency Logs</button>    <button id="subTabLocation" class="sub-tab" onclick="switchAttendanceSubTab('location')">Agent Login Location & IP Logs</button>   </div>

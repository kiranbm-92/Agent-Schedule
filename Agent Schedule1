ointer}.aux-cell-15m:hover{outline:2px solid #111;outline-offset:-2px}/* AUX Colors */.unavailable{background:#ef4444;color:#fff}.available{background:#22c55e;color:#063b19}.break{background:#3b82f6;color:#fff}.lunch{background:#f59e0b;color:#421f00}.bio{background:#06b6d4;color:#00323b}.breakpending{background:#fde047;color:#3f3000}.meeting{background:#a855f7;color:#fff}.tlfeedback{background:#ec4899;color:#fff}.qafeedback{background:#8b5cf6;color:#fff}.nht{background:#14b8a6;color:#fff}.pkt{background:#0ea5e9;color:#fff}.training{background:#6366f1;color:#fff}.coaching{background:#f97316;color:#fff}.offline{background:#64748b;color:#fff}/* Leave / Off-time Schedule-only AUX Colors */.weekoff{background:#64748b;color:#fff}.plannedleave{background:#0284c7;color:#fff}.sickleave{background:#e11d48;color:#fff}.ncns{background:#881337;color:#fff}.unpaidleave{background:#475569;color:#fff}.casualleave{background:#d97706;color:#fff}.holiday{background:#059669;color:#fff}.compoff{background:#7c3aed;color:#fff}.unplannedleave{background:#b91c1c;color:#fff}.empty{background:#fff}/* Agent timer */.agent-panel{display:grid;grid-template-columns:2fr 1fr;gap:14px}.current-status{display:flex;align-items:center;justify-content:space-between;padding:18px;border-radius:12px;background:#f8fafc}.status-code{font-size:28px;font-weight:900}.status-timer{font-size:30px;font-weight:900;font-variant-numeric:tabular-nums}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.kpi{padding:14px;border:1px solid var(--border);border-radius:10px}.kpi b{display:block;font-size:20px}.kpi small{color:var(--muted)}.summary-table{width:100%;border-collapse:collapse}.summary-table th,.summary-table td{padding:9px;border-bottom:1px solid var(--border);text-align:left;font-size:13px}/* Admin & Tables */.table-scroll{overflow:auto}.data-table{width:100%;border-collapse:collapse;min-width:1500px}.data-table th,.data-table td{padding:9px;border-bottom:1px solid var(--border);font-size:12px;text-